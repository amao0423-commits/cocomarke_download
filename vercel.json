{
  "crons": [
    {
      "path": "/api/admin/broadcast-email/run-due",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/subscription/:path*",
      "destination": "https://instagram-service-jemia.vercel.app/:path*"
    },
    {
      "source": "/lp/instagram",
      "destination": "https://instagram-service-jemia.vercel.app/lp/instagram/"
    },
    {
      "source": "/lp/instagram/:path*",
      "destination": "https://instagram-service-jemia.vercel.app/lp/instagram/:path*"
    }
  ]
}
